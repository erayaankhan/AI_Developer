# Copy to AI_DEV_ENV\local_env.env and fill in. That file is tracked in git: URLs, the test-DB allow-list and service commands only,
# never a connection string or password (those go in the git-ignored appsettings.local.json overlays). Claude never opens or prints this file.
# Keys under <profile>.<name> are environment.ts keys; their values are URLs.

# --- cloud_staging profile (Angular-only tickets): UI runs on localhost:4200 against the staging APIs
cloud_staging.GatewayAPIUrl=
cloud_staging.WF_Api_Url=
cloud_staging.BaseAPIUrl=
cloud_staging.C2M_APIUrl=

# --- cloud_preprod profile (Angular-only tickets, your choice vs cloud_staging): same, against the Preprod APIs
cloud_preprod.GatewayAPIUrl=
cloud_preprod.WF_Api_Url=
cloud_preprod.BaseAPIUrl=
cloud_preprod.C2M_APIUrl=

# --- local profile (backend or mixed tickets): local gateway + runtime API + test DB
local.GatewayAPIUrl=
local.C2M_APIUrl=
local.WF_Api_Url=
local.BaseAPIUrl=
# the ONLY databases a started service or DB script may use (host and database name, case-insensitive;
# a comma-separated list is allowed when the services use several databases)
local.db.allowed_host=
local.db.allowed_name=
# appsettings values (connection strings too) are NOT here: put them in the git-ignored local overlay file
#   <service folder>/appsettings.local.json, next to the service's appsettings.json, e.g.
#   wfapi_wf_service/wfapi_wf_microservice/appsettings.local.json   (local profile only; cloud_* profiles read no overlay):
#   {"ConnectionStrings": {"Connection": "Server=...;Database=..."}, "AppSettings": {"SomeUrl": "http://localhost:5000"}}
# `dt env-apply` merges them into the service's appsettings.json (existing keys only); `dt env-restore` puts it back.
# ConnectionStrings must match the allow-list above, otherwise nothing is written.
# (older way, still works: local.db.connection=<one test DB connection string> -> ConnectionStrings__Connection env var)
# extra environment variables for started services, e.g. local.env.ASPNETCORE_ENVIRONMENT=Development
local.env.ASPNETCORE_ENVIRONMENT=Development

# --- services Claude may start for the local profile (cwd relative to the repo root)
# C2M_API lives in another repo (absolute cwd). It is only RUN here (it serves local.C2M_APIUrl), never edited or staged.
# It also has a log DB key: set local.env.ConnectionStrings__ConnStrLog to a test log DB, or its appsettings value is used.
service.c2mapi.cwd=D:/ProjectsGit/C2M_CommonServices/C2M_API
service.c2mapi.cmd=dotnet run
service.c2mapi.url=
service.gateway.cwd=wfapi_gateway_service/wf_gateway_microservices
service.gateway.cmd=dotnet run
service.gateway.url=
service.wf.cwd=wfapi_wf_service/wfapi_wf_microservice
service.wf.cmd=dotnet run
service.wf.url=
service.bm.cwd=wfapi_bm_service/wfapi_bm_microservice
service.bm.cmd=dotnet run
service.bm.url=
