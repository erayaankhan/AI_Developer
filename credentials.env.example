# dev-ticket credentials — TEMPLATE (safe to commit, contains no secrets).
# Copy to credentials.env in this folder and fill in YOUR OWN values.
# credentials.env is git-ignored (see AI_DEV_ENV/.gitignore). Setup: SETUP.md §2.

# Assembla: your personal API key pair (Profile > API Applications & Sessions)
ASSEMBLA_API_KEY=
ASSEMBLA_API_SECRET=
# ASSEMBLA_SPACE=c2m-ci

# Build server (jenkins-build-server-4): needed to deploy a ticket on staging (deploy_staging_local.py)
JENKINS_REMOTE_USER=
JENKINS_REMOTE_API_TOKEN=
# JENKINS_REMOTE_BASE_URL=https://jenkins-build-server-4.c2minternal.com

# Teams: the team's channel webhook (Workflows), from the lead. Used at hand-off to @mention the reviewer.
# Keep it secret: anyone with the URL can post to the channel.
# TEAMS_WEBHOOK_URL_GENAI=
# TEAMS_WEBHOOK_URL_LAUNCHPAD=
# TEAMS_WEBHOOK_URL_IMW2=

# Sonar / Snyk (dt quality, Launchpad): your SonarQube USER token and your Snyk auth token.
# SONAR_TOKEN=
# SNYK_TOKEN=
